{
  "manifest_version": 3,
  "name": "Tailor Observer",
  "version": "0.1.0",
  "description": "Sends permissioned browsing signals (sites, tab titles, time, copy/paste counts; never content) to the Tailor app on this computer.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "http://127.0.0.1:47821/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tailor"
  },
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  }
}
